<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/math_master_home_widget_background" android:clipToOutline="true" android:outlineProvider="background">
    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Study artwork"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <View
        android:id="@+id/widget_artwork_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/math_master_widget_art_overlay_minimal_progress"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="4dp">


    <LinearLayout
        android:id="@+id/widget_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="MATH MASTER"
            android:textColor="#EDEAFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_update_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/math_master_home_widget_badge"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="UPDATE"
            android:textColor="#DCCFFF"
            android:textSize="7sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_primary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_progress_ring"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="7dp"
            android:contentDescription="Daily completion progress"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_progress_percent"
            android:layout_width="wrap_content"
            android:minWidth="50dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:text="0%"
            android:textColor="#C7B4FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_target_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_target_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.03"
                android:text="TODAY'S TARGET"
                android:textColor="#AFAAC7"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_target_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="30 min target"
                android:textColor="#F6F4FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="1dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#45415E"
        android:progressTint="#B8A0FF"
        android:indeterminate="false" />

    <TextView
        android:id="@+id/widget_flex_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_study_remaining_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_study_time_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="2 min studied"
            android:textColor="#C9C5DB"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/widget_remaining_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="28 min left today"
            android:textColor="#C9C5DB"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_streak_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_streak_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="🔥 0-day streak"
            android:textColor="#E7D8A8"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_week_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_week_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="THIS WEEK · LAST 7 DAYS"
            android:textColor="#9F9AB8"
            android:textSize="6sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_week_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="7">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_week_day_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="M"
                    android:textColor="#9F9AB8"
                    android:textSize="6sp" />
                <TextView
                    android:id="@+id/widget_week_date_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="18"
                    android:textColor="#9F9AB8"
                    android:textSize="5sp" />
                <TextView
                    android:id="@+id/widget_week_status_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="·"
                    android:textColor="#9F9AB8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_week_day_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="M"
                    android:textColor="#9F9AB8"
                    android:textSize="6sp" />
                <TextView
                    android:id="@+id/widget_week_date_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="18"
                    android:textColor="#9F9AB8"
                    android:textSize="5sp" />
                <TextView
                    android:id="@+id/widget_week_status_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="·"
                    android:textColor="#9F9AB8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_week_day_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="M"
                    android:textColor="#9F9AB8"
                    android:textSize="6sp" />
                <TextView
                    android:id="@+id/widget_week_date_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="18"
                    android:textColor="#9F9AB8"
                    android:textSize="5sp" />
                <TextView
                    android:id="@+id/widget_week_status_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="·"
                    android:textColor="#9F9AB8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_week_day_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="M"
                    android:textColor="#9F9AB8"
                    android:textSize="6sp" />
                <TextView
                    android:id="@+id/widget_week_date_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="18"
                    android:textColor="#9F9AB8"
                    android:textSize="5sp" />
                <TextView
                    android:id="@+id/widget_week_status_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="·"
                    android:textColor="#9F9AB8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_week_day_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="M"
                    android:textColor="#9F9AB8"
                    android:textSize="6sp" />
                <TextView
                    android:id="@+id/widget_week_date_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="18"
                    android:textColor="#9F9AB8"
                    android:textSize="5sp" />
                <TextView
                    android:id="@+id/widget_week_status_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="·"
                    android:textColor="#9F9AB8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_week_day_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="M"
                    android:textColor="#9F9AB8"
                    android:textSize="6sp" />
                <TextView
                    android:id="@+id/widget_week_date_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="18"
                    android:textColor="#9F9AB8"
                    android:textSize="5sp" />
                <TextView
                    android:id="@+id/widget_week_status_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="·"
                    android:textColor="#9F9AB8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_week_day_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="M"
                    android:textColor="#9F9AB8"
                    android:textSize="6sp" />
                <TextView
                    android:id="@+id/widget_week_date_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="18"
                    android:textColor="#9F9AB8"
                    android:textSize="5sp" />
                <TextView
                    android:id="@+id/widget_week_status_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="·"
                    android:textColor="#9F9AB8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_update_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Updates refresh when the app opens"
        android:textColor="#9F9AB8"
        android:textSize="7sp" />

    <TextView
        android:id="@+id/widget_disabled_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Widgets are off"
        android:textColor="#B8A0FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
</FrameLayout>
